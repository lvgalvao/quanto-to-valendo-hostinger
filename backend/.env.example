# === Backend — Quanto Tô Valendo · WhatsApp Edition ===
# Copie para backend/.env e preencha. Este arquivo NUNCA é versionado (.gitignore).

# Chave da API Anthropic — SÓ existe no backend, nunca chega ao frontend nem a logs (invariante #8).
# Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo default do agente. Sobrescrito pela config do painel (Settings) se houver.
MODELO_AGENTE=claude-haiku-4-5

# Token de admin exigido em TODAS as rotas /api/* e no handshake do Socket.IO (header X-Admin-Token).
# Use um valor forte e único — o painel é público e cada análise custa API.
ADMIN_TOKEN=troque-este-token-por-um-forte

# Porta do backend (Express + Socket.IO).
PORT=3001
