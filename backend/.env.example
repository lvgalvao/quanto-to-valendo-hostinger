# Chave da API Anthropic — SÓ existe no backend, nunca chega ao frontend nem a logs (invariante #8).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo default do agente. Sobrescrito pela config do painel se houver.
MODELO_AGENTE=claude-haiku-4-5

# Token de admin exigido em todas as rotas e no handshake do Socket.IO (header X-Admin-Token).
ADMIN_TOKEN=troque-este-token

# Porta do backend.
PORT=3001
